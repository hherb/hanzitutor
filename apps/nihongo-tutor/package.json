{
  "name": "nihongo-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn to read and write Japanese kana",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "TAURI_ROOT=\"$PWD\" ../../scripts/with-cargo-env.sh ../../scripts/tauri-cli.sh dev",
    "dev:signed": "../../scripts/dev-signed.sh --root \"$PWD\" --package nihongo-tutor --identifier com.hanzitutor.kana",
    "build": "TAURI_ROOT=\"$PWD\" ../../scripts/build-release.sh",
    "vite:dev": "vite",
    "vite:build": "vite build",
    "check:web": "svelte-check --tsconfig ./tsconfig.json",
    "test:rust": "cd ../.. && ./scripts/with-cargo-env.sh cargo test -p nihongo-tutor"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tauri-apps/cli": "^2.12.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
