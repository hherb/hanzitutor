{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanzi Tutor",
  "version": "0.5.9",
  "identifier": "com.hanzitutor.app",
  "build": {
    "beforeDevCommand": "pnpm run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hanzi Tutor",
        "width": 1180,
        "height": 840,
        "minWidth": 940,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Education",
    "shortDescription": "Learn to read and write simplified Chinese characters",
    "longDescription": "An offline app for practising simplified Chinese handwriting. It grades each stroke for shape, placement, ink and order against real stroke geometry, teaches a frequency-ordered course, the HSK 3.0 word list, your own vocabulary and a spaced-repetition review queue, scores tone from the pitch of your own voice, speaks characters and words with the system's own voice, and plays the graded phrases from recordings that ship in the bundle. Everything the course teaches is in this bundle and needs no network. Two optional models can be fetched from the settings screen — one that reads a recording back as syllables, and one that speaks a phrase the app has no recording of — and each is fetched only when you ask for it, never on its own.",
    "copyright": "Copyright © Horst Herb and contributors",
    "resources": {
      "../LICENSE": "licences/AGPL-3.0.txt",
      "../LICENSES.md": "licences/PROVENANCE.md",
      "../licences/Arphic-Public-License.txt": "licences/Arphic-Public-License.txt",
      "../licences/MakeMeAHanzi-COPYING.txt": "licences/MakeMeAHanzi-COPYING.txt",
      "../licences/LGPL-3.0.txt": "licences/LGPL-3.0.txt",
      "../licences/MIT-hanziDB.txt": "licences/MIT-hanziDB.txt",
      "../licences/MIT-complete-hsk-vocabulary.txt": "licences/MIT-complete-hsk-vocabulary.txt",
      "../licences/CC-CEDICT.txt": "licences/CC-CEDICT.txt",
      "../licences/CC-BY-SA-4.0.txt": "licences/CC-BY-SA-4.0.txt",
      "../licences/CC-BY-4.0.txt": "licences/CC-BY-4.0.txt",
      "../licences/NO7Z-hsk-sentences-audio.txt": "licences/NO7Z-hsk-sentences-audio.txt",
      "../licences/HARUKICODER-hsk30-graded-readers.txt": "licences/HARUKICODER-hsk30-graded-readers.txt",
      "../licences/MIT-MeloTTS.txt": "licences/MIT-MeloTTS.txt",
      "../licences/OFL-1.1.txt": "licences/OFL-1.1.txt",
      "../licences/SQLite-Public-Domain.txt": "licences/SQLite-Public-Domain.txt",
      "../licences/MIT-rusqlite.txt": "licences/MIT-rusqlite.txt",
      "../licences/Apache-2.0.txt": "licences/Apache-2.0.txt",
      "../licences/MIT-onnxruntime.txt": "licences/MIT-onnxruntime.txt",
      "../licences/GPL-3.0.txt": "licences/GPL-3.0.txt"
    },
    "android": {
      "minSdkVersion": 26
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
