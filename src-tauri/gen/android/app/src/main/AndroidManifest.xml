<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app makes exactly one kind of network request, and only because the
         learner asked for it: the optional speech-recognition model, downloaded
         from the settings screen. It is 163 MB, so it cannot be bundled, and it
         is the only reason this permission is here.

         It used to be declared for debug builds only, which made "it works
         offline" a claim anyone could check on the artifact with
         `aapt2 dump permissions`. That is no longer true, and pretending
         otherwise would mean shipping a settings button that always fails — so
         the permission is declared and the claim was restated rather than
         quietly dropped. What has *not* changed: nothing is ever sent, nothing
         is collected, and no request happens unless this download is started.
         See LICENSES.md and ROADMAP.md M12. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Tone practice records the learner's own voice, for as long as they hold
         the button. It is asked for at runtime on the first launch (see
         MainActivity): declaring it alone would let `cpal` open a device that
         only ever delivers silence, which is a failure the app cannot see. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11 and later hide other packages from an app unless it asks for
         them by intent. Without this, `TextToSpeech` cannot see the speech
         engine that is installed on the device, and `getDefaultEngine()`
         answers null even though one is plainly there — which shows up as an
         engine that lists voices and then says nothing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.hanzi_tutor"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
