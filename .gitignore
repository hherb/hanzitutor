# --- Rust / Cargo ---------------------------------------------------------
# Compiled output.
target
debug
**/*.rs.bk
*.pdb
**/mutants.out*/

# This project keeps its own CARGO_HOME and target directory in-tree, so that
# builds work under a restricted file sandbox that forbids writing to ~/.cargo.
# See scripts/with-cargo-env.sh.
.cargo-home/
.cargo-target/

# --- Frontend ------------------------------------------------------------
node_modules/
dist/
.pnpm-store/
.probe/

# --- Generated character data -------------------------------------------
# ~33 MB of upstream text plus the compact artifact, rebuilt with
# `pnpm run fetch-data && pnpm run prepare-data`. A fresh clone must run those
# before it will compile.
data/raw/
crates/hanzi-core/data/*.bin.gz

# Schema files Tauri generates for capability auto-completion. Regenerated by
# any build, so not tracked, matching the official Tauri template.
src-tauri/gen/schemas/

# --- Local study data ----------------------------------------------------
# Suggested by HANDOVER.md for running the app where the real application data
# directory is not writable (sandboxes, portable installs). A directory like
# this can hold vocabulary.json, progress.json and course-cursor.json.
.tmp-vocab/
.tmp-data/
.study/

# --- Editor / OS ---------------------------------------------------------
#.idea/
.DS_Store
