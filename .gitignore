# --- Rust / Cargo ---------------------------------------------------------
# Compiled output.
target
debug
**/*.rs.bk
*.pdb
**/mutants.out*/

# This project keeps its own CARGO_HOME and target directory in-tree, so that
# builds work under a restricted file sandbox that forbids writing to ~/.cargo.
# See scripts/with-cargo-env.sh.
.cargo-home/
.cargo-target/

# Gradle's home, kept in-tree for the same reason: the default is `~/.gradle`,
# which a sandboxed build cannot write. See HANDOVER §6 for the working command —
# the wrapper cannot run this way, the unpacked launcher can.
.gradle-home/
# Kotlin's incremental-compilation cache, left by every Gradle build of the
# Android project and never wanted in the repository.
.kotlin/

# --- Python ---------------------------------------------------------------
# Byte-code for the helper scripts in scripts/, written whenever one of them
# is imported rather than run.
__pycache__/
*.py[cod]

# The sherpa-onnx native library that `src-tauri` links against, unpacked by
# scripts/fetch-sherpa.sh and pinned there by digest. About 20 MB of prebuilt
# objects — a build input, not source, so re-fetch rather than commit it. The
# model it recognises with is not here either: that is downloaded at run time,
# only when the learner asks, and lives in the application data directory.
.sherpa-onnx/

# --- Frontend ------------------------------------------------------------
node_modules/
dist/
.pnpm-store/
.probe/

# --- Data -----------------------------------------------------------------
# The ~33 MB of upstream text is not committed: it can always be re-fetched
# with `pnpm run fetch-data`.
data/raw/

# The compact artifact IS committed — crates/hanzi-core/data/hanzi.bin.gz is
# ~13 MB. It used to be generated-only, which meant a fresh clone (and CI) had
# to fetch 33 MB and rebuild it before the workspace would even compile.
# Regenerate it with `pnpm run fetch-data && pnpm run prepare-data`, and bump
# ARTIFACT_MAGIC in crates/hanzi-core/src/dataset.rs whenever its payload shape
# changes — see HANDOVER.md, invariant 16.

# The bundled interface font (~17 MB) is committed for the same reason, so a
# clone builds without a download. See scripts/fetch-data.sh to restore it.

# Schema files Tauri generates for capability auto-completion. Regenerated by
# any build, so not tracked, matching the official Tauri template.
src-tauri/gen/schemas/

# --- Local study data ----------------------------------------------------
# Suggested by HANDOVER.md for running the app where the real application data
# directory is not writable (sandboxes, portable installs). A directory like
# this can hold vocabulary.json, progress.json and course-cursor.json.
.tmp-vocab/
.tmp-data/
.tmp-*/
.study/

# --- Editor / OS ---------------------------------------------------------
#.idea/
.DS_Store
